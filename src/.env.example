# Copiar a .env y configurar localmente; los placeholders no son credenciales validas.
# Generar clave Fernet: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENTORNO_APLICACION=desarrollo
CADENA_CONEXION_POSTGRESQL=postgresql+psycopg://usuario:REEMPLAZAR_SECRETO_LOCAL@localhost:5432/calidad_web
CLAVE_SESION=REEMPLAZAR_CLAVE_SESION_LOCAL
CLAVE_JWT=REEMPLAZAR_CLAVE_JWT_LOCAL
CLAVE_CIFRADO_SECRETOS=REEMPLAZAR_CON_CLAVE_FERNET_GENERADA_LOCALMENTE
RUTA_EVIDENCIAS=almacenamiento/evidencias
ORIGEN_FRONTEND_PERMITIDO=http://localhost:5173
URL_PUBLICA_BACKEND=http://localhost:5000
URL_PUBLICA_FRONTEND=http://localhost:5173
NAVEGADOR_SELENIUM=chrome
MODO_HEADLESS=true
TIEMPO_ESPERA_PREDETERMINADO=15
SERVIDOR_SMTP=localhost
PUERTO_SMTP=1025
USUARIO_SMTP=
CONTRASENA_SMTP=
REMITENTE_SMTP=notificaciones@example.invalid
RUTA_INFORMES=almacenamiento/informes
ZONA_HORARIA_APLICACION=America/Guatemala
ADJUNTAR_PDF_DISCORD=true
TAMANO_MAXIMO_PDF_DISCORD=8000000
